{
  // ==========================================================================
  // Tableau MCP Server - Wrangler Configuration
  // ==========================================================================
  //
  // MULTI-TENANT ARCHITECTURE:
  // This server supports multiple tenants. Credentials are passed via request
  // headers, NOT stored as wrangler secrets. This allows a single deployment
  // to serve multiple customers.
  //
  // REQUIRED HEADERS:
  // - X-Tableau-Server-URL: Tableau Server or Cloud URL
  // - X-Tableau-PAT-Name: Personal Access Token name
  // - X-Tableau-PAT-Secret: Personal Access Token secret
  //
  // OPTIONAL HEADERS:
  // - X-Tableau-Site-Content-URL: Site content URL (empty for default site)
  // - X-Tableau-Auth-Token: Pre-existing auth token
  // - X-Tableau-API-Version: API version (default: 3.21)
  // ==========================================================================

  "name": "primrose-mcp-tableau",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // ==========================================================================
  // Environment Variables (server-wide configuration, not per-tenant)
  // ==========================================================================
  "vars": {
    "CHARACTER_LIMIT": "50000",
    "DEFAULT_PAGE_SIZE": "100",
    "MAX_PAGE_SIZE": "1000",
    "DEFAULT_API_VERSION": "3.21"
  },

  // ==========================================================================
  // KV Namespace (uncomment for auth token caching)
  // ==========================================================================
  // Create: npx wrangler kv namespace create "AUTH_KV"
  //
  // "kv_namespaces": [
  //   {
  //     "binding": "AUTH_KV",
  //     "id": "<YOUR_KV_NAMESPACE_ID>"
  //   }
  // ],

  // ==========================================================================
  // Durable Objects (uncomment for stateful sessions)
  // ==========================================================================
  // "durable_objects": {
  //   "bindings": [
  //     {
  //       "name": "MCP_SESSIONS",
  //       "class_name": "TableauMcpAgent"
  //     }
  //   ]
  // },
  // "migrations": [
  //   {
  //     "tag": "v1",
  //     "new_classes": ["TableauMcpAgent"]
  //   }
  // ],

  // ==========================================================================
  // Development
  // ==========================================================================
  "dev": {
    "port": 8787,
    "local_protocol": "http"
  },

  "observability": {
    "enabled": true
  }
}
